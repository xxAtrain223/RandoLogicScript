<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>extend region declaration</Title>
      <Shortcut>extend</Shortcut>
      <Description>Creates an RLS region extension.</Description>
      <Author>Rando Logic Script</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal><ID>name</ID><ToolTip>Existing region name</ToolTip><Default>NAME</Default></Literal>
      </Declarations>
      <Code Language="RLS"><![CDATA[extend region $name$ {
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>