<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>enum declaration</Title>
      <Shortcut>enum</Shortcut>
      <Description>Creates an RLS enum declaration.</Description>
      <Author>Rando Logic Script</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal><ID>name</ID><ToolTip>Enum name</ToolTip><Default>NAME</Default></Literal>
      </Declarations>
      <Code Language="RLS"><![CDATA[enum $name$ {
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>