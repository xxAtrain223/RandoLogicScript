<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>exits section</Title>
      <Shortcut>exits</Shortcut>
      <Description>Creates an RLS exits section.</Description>
      <Author>Rando Logic Script</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet><Code Language="RLS"><![CDATA[exits {
    $end$
}]]></Code></Snippet>
  </CodeSnippet>
</CodeSnippets>