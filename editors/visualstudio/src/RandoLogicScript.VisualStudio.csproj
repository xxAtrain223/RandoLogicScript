<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RandoLogicScript.VisualStudio</RootNamespace>
    <AssemblyName>RandoLogicScript.VisualStudio</AssemblyName>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <RlsLanguageServerPath Condition="'$(RlsLanguageServerPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\build-visualstudio-release\lsp\rls_language_server.exe</RlsLanguageServerPath>
    <RlsNativeValidatorPath>$(MSBuildThisFileDirectory)..\..\shared\validate-native-binary.mjs</RlsNativeValidatorPath>
    <GetVsixSourceItemsDependsOn>PrepareRlsLanguageServer;$(GetVsixSourceItemsDependsOn)</GetVsixSourceItemsDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="RandoLogicScript.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vscode\syntaxes\rls.tmLanguage.json">
      <Link>Grammars\rls.tmLanguage.json</Link>
      <TargetPath>rls.tmLanguage.json</TargetPath>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\vscode\language-configuration.json">
      <Link>language-configuration.json</Link>
      <TargetPath>language-configuration.json</TargetPath>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\LICENSE">
      <Link>LICENSE.txt</Link>
      <TargetPath>LICENSE.txt</TargetPath>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareRlsLanguageServer">
    <Error
      Condition="'$(RlsLanguageServerPath)' == ''"
      Text="RlsLanguageServerPath is required. Configure and build the static x64 Release rls_language_server target before packaging." />
    <Error
      Condition="!Exists('$(RlsLanguageServerPath)')"
      Text="RLS language server was not found at '$(RlsLanguageServerPath)'. Build it with BUILD_TESTING=OFF and RLS_STATIC_MSVC_RUNTIME=ON, then set /p:RlsLanguageServerPath=&lt;path&gt;." />
    <Exec
      Command="node &quot;$(RlsNativeValidatorPath)&quot; &quot;$(RlsLanguageServerPath)&quot; win32-x64"
      WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="$(RlsLanguageServerPath)">
        <Link>Server\rls_language_server.exe</Link>
        <TargetPath>rls_language_server.exe</TargetPath>
        <VSIXSubPath>Server</VSIXSubPath>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>
</Project>